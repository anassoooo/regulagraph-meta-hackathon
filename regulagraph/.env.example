# Copy to .env and fill in locally. Never commit .env.

# Meta Model API key (dashboard -> API keys). Header: "Authorization: Bearer <key>".
MODEL_API_KEY=

# Billing safeguard: no inference request is sent unless this is explicitly "true".
META_INFERENCE_ENABLED=false

META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL_ID=muse-spark-1.3
# Hard cap applied to every request (max_completion_tokens).
META_MAX_COMPLETION_TOKENS=1024
META_REQUEST_TIMEOUT_SECONDS=60
# Upper bound on provision text (characters) placed in one prompt.
META_MAX_PROMPT_CHARS=24000

# Ingestion limits: checked before parsing (bytes) and before text extraction (pages).
MAX_PDF_BYTES=20000000
MAX_PDF_PAGES=200

LOG_LEVEL=INFO
